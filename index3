<!DOCTYPE html>
<html lang="en">
<head>

<!-- Modern browsers -->
<link rel="icon" type="image/svg+xml" href="Sm1.svg">
<link rel="icon" type="image/png" sizes="32x32" href="Sm1.png">
<link rel="apple-touch-icon" href="Sm1.png">

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>GRID ACADEMY | Power Systems Engineering Courses</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@500;600;700;800&family=Inter:wght@400;500;600;700&family=Tajawal:wght@400;500;700;800&display=swap" rel="stylesheet" />
<style>
  :root {
    /* Core brand */
    --ink:            #0b1613;
    --ink-soft:       #12211d;
    --paper:          #f7f5f0;
    --paper-dim:      #efece4;
    --white:          #FFFFFF;
    --text-dark:      #16211d;
    --text-mute:      #5c6a63;

    --emerald:        #009268;
    --emerald-dark:   #045c40;
    --emerald-light:  #00b37d;
    --emerald-glow:   rgba(0,146,104,0.15);

    /* Copper accent, used sparingly for premium touches */
    --copper:         #c1893f;
    --copper-dark:    #9c6c2c;
    --copper-glow:    rgba(193,137,63,0.16);

    --line-dark:      rgba(255,255,255,0.12);
    --line-light:     rgba(22,33,29,0.12);
    --shadow:         0 10px 30px rgba(11,22,19,0.10);
    --shadow-lift:    0 20px 48px rgba(11,22,19,0.16);
    --radius:         10px;

    /* Course identities */
    --pv-primary:      #1a5276;
    --pv-primary-dark: #123c56;
    --pv-glow:         rgba(26,82,118,0.15);

    --pss-primary:      #6b21a8;
    --pss-primary-dark: #4c1877;
    --pss-glow:         rgba(107,33,168,0.15);

    --pd-primary:       #b5541c;
    --pd-primary-dark:  #8f4116;
    --pd-glow:          rgba(181,84,28,0.15);

    --psse-primary:      #115e59;
    --psse-primary-dark: #0b3f3b;
    --psse-glow:         rgba(17,94,89,0.15);
  }

  * { margin:0; padding:0; box-sizing:border-box; }

  html { scroll-behavior: smooth; }

  body {
    font-family: 'Inter', sans-serif;
    background: var(--paper);
    color: var(--text-dark);
    overflow-x: hidden;
  }

  h1, h2, h3, .display {
    font-family: 'IBM Plex Sans', sans-serif;
  }

  html[dir="rtl"] body,
  html[dir="rtl"] h1,
  html[dir="rtl"] h2,
  html[dir="rtl"] h3,
  html[dir="rtl"] .display {
    font-family: 'Tajawal', 'IBM Plex Sans', sans-serif;
  }

  a { color: inherit; }

  ::selection { background: var(--emerald); color: white; }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    * { transition: none !important; animation: none !important; }
  }

  a:focus-visible, button:focus-visible {
    outline: 2px solid var(--copper);
    outline-offset: 3px;
  }

  /* ── NAV ── */
  .top-nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(11,22,19,0.94);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line-dark);
  }
  .nav-inner {
    max-width: 1240px;
    margin: 0 auto;
    padding: 14px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }
  .nav-brand {
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--white);
    text-decoration: none;
    letter-spacing: 0.5px;
    display: flex;
    align-items: center;
    gap: 10px;
    white-space: nowrap;
  }
  .nav-logo { height: 26px; width: auto; filter: brightness(0) invert(1); flex-shrink: 0; }
  .nav-right { display: flex; align-items: center; gap: 14px; }
  .nav-year {
    color: rgba(255,255,255,0.5);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.3px;
    display: none;
  }
  .btn-notify {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--copper);
    color: var(--ink);
    padding: 9px 18px;
    border-radius: 7px;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.85rem;
    white-space: nowrap;
    transition: background 0.2s ease, transform 0.2s ease;
  }
  .btn-notify:hover { background: #d69c53; transform: translateY(-1px); }

  .lang-toggle {
    display: flex;
    border: 1px solid var(--line-dark);
    border-radius: 7px;
    overflow: hidden;
  }
  .lang-btn {
    background: transparent;
    color: rgba(255,255,255,0.6);
    border: none;
    padding: 8px 12px;
    font-size: 0.8rem;
    font-weight: 700;
    cursor: pointer;
    font-family: 'Inter', sans-serif;
    transition: background 0.2s ease, color 0.2s ease;
  }
  .lang-btn.active { background: var(--emerald); color: white; }
  .lang-btn:not(.active):hover { background: rgba(255,255,255,0.08); color: white; }

  .progress-track {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    height: 3px;
    background: transparent;
  }
  .progress-fill {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, var(--emerald), var(--copper));
    transition: width 0.1s linear;
  }

  @media (min-width: 640px) { .nav-year { display: inline; } }

  /* ── HERO ── */
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--ink);
  }
  .hero-photo {
    position: absolute; inset: 0;
    background-image:
      linear-gradient(100deg, rgba(6,14,12,0.96) 0%, rgba(6,14,12,0.82) 38%, rgba(6,14,12,0.5) 68%, rgba(6,14,12,0.6) 100%),
      url('https://images.unsplash.com/photo-1413882353314-73389f63b6fd?fm=jpg&q=80&w=2200&auto=format&fit=crop');
    background-size: cover;
    background-position: center 35%;
  }
  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 1240px;
    margin: 0 auto;
    width: 100%;
    padding: clamp(72px, 12vw, 140px) 24px clamp(48px, 6vw, 80px);
    display: grid;
    grid-template-columns: minmax(0, 640px) minmax(0, 1fr);
    align-items: center;
    gap: 24px;
  }
  .hero-inner { max-width: 640px; min-width: 0; }
  .hero-sld-wrap {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    min-width: 0;
  }
  .hero-sld {
    width: 100%;
    max-width: 420px;
    height: auto;
    opacity: 0.5;
  }
  @media (max-width: 900px) {
    .hero-content { grid-template-columns: 1fr; }
    .hero-sld-wrap { display: none; }
  }
  .hero-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--copper);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.3px;
    margin-bottom: 22px;
  }
  .hero-tag i { font-size: 0.7rem; }
  .hero h1 {
    font-size: clamp(2.1rem, 4.6vw, 3.4rem);
    font-weight: 700;
    color: white;
    line-height: 1.14;
    margin-bottom: 22px;
    letter-spacing: -0.5px;
  }
  .hero h1 em {
    font-style: normal;
    color: var(--emerald-light);
  }
  .hero p {
    font-size: 1.08rem;
    color: rgba(255,255,255,0.78);
    max-width: 500px;
    margin-bottom: 36px;
    line-height: 1.7;
  }
  .hero-ctas { display: flex; gap: 14px; flex-wrap: wrap; margin-bottom: 56px; }
  .btn-hero-primary {
    background: var(--emerald);
    color: white;
    padding: 15px 26px;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.95rem;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    transition: background 0.2s ease, transform 0.2s ease;
  }
  .btn-hero-primary:hover { background: var(--emerald-dark); transform: translateY(-1px); }
  .btn-hero-outline {
    border: 1.5px solid rgba(255,255,255,0.35);
    color: white;
    padding: 15px 26px;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.95rem;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    transition: all 0.2s ease;
  }
  .btn-hero-outline:hover { background: rgba(255,255,255,0.1); border-color: rgba(255,255,255,0.6); }

  /* ── STATS STRIP ── */
  .stats-strip {
    position: relative;
    z-index: 1;
    background: var(--ink-soft);
    border-top: 1px solid var(--line-dark);
  }
  .stats-inner {
    max-width: 1240px;
    margin: 0 auto;
    padding: 28px 24px;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    column-gap: 20px;
    row-gap: 18px;
  }
  .stat {
    min-width: 0;
    padding-left: 22px;
    border-left: 1px solid var(--line-dark);
  }
  .stat:first-child { border-left: none; padding-left: 0; }
  @media (max-width: 720px) {
    .stats-inner { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .stat { border-left: none; padding-left: 0; padding-top: 14px; border-top: 1px solid var(--line-dark); }
    .stat:nth-child(-n+2) { padding-top: 0; border-top: none; }
  }
  @media (max-width: 380px) {
    .stats-inner { grid-template-columns: 1fr; }
    .stat { border-top: 1px solid var(--line-dark); padding-top: 14px; }
    .stat:first-child { border-top: none; padding-top: 0; }
  }
  .stat-number {
    font-family: 'IBM Plex Sans', sans-serif;
    font-size: 1.7rem;
    font-weight: 700;
    color: var(--copper);
    display: block;
    line-height: 1;
    margin-bottom: 6px;
  }
  .stat-label {
    font-size: 0.82rem;
    color: rgba(255,255,255,0.6);
    font-weight: 500;
  }

  /* ── COURSES SECTION ── */
  .courses-section {
    max-width: 1240px;
    margin: 0 auto;
    padding: 96px 24px 40px;
  }
  .section-head { max-width: 620px; margin-bottom: 52px; }
  .section-label {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--emerald);
    margin-bottom: 12px;
  }
  .section-title {
    font-size: clamp(1.6rem, 3vw, 2.15rem);
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 14px;
    letter-spacing: -0.3px;
  }
  .section-sub {
    color: var(--text-mute);
    font-size: 1.02rem;
    line-height: 1.65;
  }

  .courses-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: 28px;
  }

  /* ── COURSE CARD ── */
  .course-card {
    background: white;
    border-radius: var(--radius);
    border: 1px solid var(--line-light);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }
  .course-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-lift);
    border-color: transparent;
  }

  .card-banner {
    height: 176px;
    position: relative;
    display: flex;
    align-items: flex-end;
    padding: 18px 22px;
    overflow: hidden;
    background-size: cover;
    background-position: center;
  }
  .card-banner-sd {
    background-image:
      linear-gradient(180deg, rgba(4,45,32,0.35) 0%, rgba(4,45,32,0.88) 100%),
      url('https://images.unsplash.com/photo-1509390221805-d1c887a72a00?fm=jpg&q=75&w=1200&auto=format&fit=crop');
  }
  .card-banner-pv {
    background-image:
      linear-gradient(180deg, rgba(18,60,86,0.35) 0%, rgba(18,60,86,0.88) 100%),
      url('https://images.unsplash.com/photo-1592263904934-b00851dc93eb?fm=jpg&q=75&w=1200&auto=format&fit=crop');
  }
  .card-banner-pss {
    background-image:
      linear-gradient(180deg, rgba(76,24,119,0.4) 0%, rgba(76,24,119,0.9) 100%),
      url('https://images.unsplash.com/photo-1560977466-c02ffbb12189?fm=jpg&q=75&w=1200&auto=format&fit=crop');
  }
  .card-banner-pd {
    background-image:
      linear-gradient(180deg, rgba(143,65,22,0.4) 0%, rgba(143,65,22,0.9) 100%),
      url('https://images.unsplash.com/photo-1566417110090-6b15a06ec800?fm=jpg&q=75&w=1200&auto=format&fit=crop');
  }
  .card-banner-psse {
    background: linear-gradient(135deg, var(--psse-primary-dark) 0%, var(--psse-primary) 100%);
  }
  .banner-pattern {
    position: absolute; inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.06) 1px, transparent 1px);
    background-size: 25px 25px;
  }
  .banner-wave {
    position: absolute; inset: 0;
    opacity: 0.5;
  }
  .banner-icon {
    position: absolute;
    right: 18px; top: 18px;
    width: 46px; height: 46px;
    background: rgba(255,255,255,0.14);
    border: 1px solid rgba(255,255,255,0.25);
    border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.15rem;
    color: rgba(255,255,255,0.92);
  }
  .banner-badge {
    position: relative;
    z-index: 1;
    background: rgba(0,0,0,0.28);
    border: 1px solid rgba(255,255,255,0.3);
    color: white;
    padding: 5px 13px;
    border-radius: 20px;
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.2px;
    display: inline-flex;
    align-items: center;
  }
  .dot-live { color: #4ade80; }
  .dot-open { color: #ffd166; }
  .dot-soon { color: rgba(255,255,255,0.6); }

  .card-body { padding: 26px 24px; flex: 1; display: flex; flex-direction: column; }

  .card-title {
    font-family: 'IBM Plex Sans', sans-serif;
    font-size: 1.22rem;
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 11px;
    line-height: 1.32;
  }
  .card-description {
    font-size: 0.94rem;
    color: var(--text-mute);
    line-height: 1.62;
    margin-bottom: 20px;
    flex: 1;
  }

  .card-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 22px;
  }
  .meta-chip {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.8rem;
    color: var(--ink);
    background: var(--paper);
    padding: 5px 11px;
    border-radius: 20px;
    font-weight: 500;
  }
  .meta-chip i { color: var(--emerald); font-size: 0.78rem; }
  .meta-chip i.pss-icon { color: var(--pss-primary); }
  .meta-chip i.pd-icon { color: var(--pd-primary); }
  .meta-chip i.psse-icon { color: var(--psse-primary); }
  .meta-chip i.pv-icon { color: var(--pv-primary); }

  .card-divider { border: none; border-top: 1px solid var(--line-light); margin-bottom: 20px; }

  .card-instructor { display: flex; align-items: center; gap: 10px; margin-bottom: 20px; }
  .card-instructor.two-up { align-items: flex-start; }
  .instructor-avatar {
    width: 36px; height: 36px;
    background: var(--emerald-glow);
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    color: var(--emerald);
    font-size: 0.85rem;
    flex-shrink: 0;
  }
  .instructor-avatar-blue { background: var(--pv-glow); color: var(--pv-primary); }
  .instructor-avatar-purple { background: var(--pss-glow); color: var(--pss-primary); }
  .instructor-avatar-orange { background: var(--pd-glow); color: var(--pd-primary); }
  .instructor-avatar-teal { background: var(--psse-glow); color: var(--psse-primary); }
  .instructor-avatar-stack { display: flex; flex-shrink: 0; }
  .instructor-avatar-stack .instructor-avatar { border: 2px solid white; }
  .instructor-avatar-stack .instructor-avatar:not(:first-child) { margin-left: -12px; }
  .instructor-name { font-size: 0.89rem; font-weight: 600; color: var(--ink); }
  .instructor-title { font-size: 0.77rem; color: var(--text-mute); }

  .card-actions { display: flex; gap: 10px; flex-wrap: wrap; }
  .btn-primary {
    flex: 1;
    text-align: center;
    padding: 12px 18px;
    background: var(--emerald);
    color: white;
    text-decoration: none;
    border-radius: 8px;
    font-weight: 700;
    font-size: 0.88rem;
    transition: background 0.2s ease, transform 0.2s ease;
    display: flex; align-items: center; justify-content: center; gap: 8px;
  }
  .btn-primary:hover { background: var(--emerald-dark); transform: translateY(-1px); }
  .btn-primary-blue { background: var(--pv-primary); }
  .btn-primary-blue:hover { background: var(--pv-primary-dark); }
  .btn-primary-purple { background: var(--pss-primary); }
  .btn-primary-purple:hover { background: var(--pss-primary-dark); }
  .btn-primary-orange { background: var(--pd-primary); }
  .btn-primary-orange:hover { background: var(--pd-primary-dark); }
  .btn-primary-teal { background: var(--psse-primary); }
  .btn-primary-teal:hover { background: var(--psse-primary-dark); }

  .btn-outline {
    padding: 12px 15px;
    border: 1.5px solid var(--emerald);
    color: var(--emerald);
    text-decoration: none;
    border-radius: 8px;
    font-weight: 700;
    font-size: 0.88rem;
    transition: all 0.2s ease;
    display: flex; align-items: center; justify-content: center;
  }
  .btn-outline:hover { background: var(--emerald); color: white; }
  .btn-outline-blue { border-color: var(--pv-primary); color: var(--pv-primary); }
  .btn-outline-blue:hover { background: var(--pv-primary); color: white; }
  .btn-outline-purple { border-color: var(--pss-primary); color: var(--pss-primary); }
  .btn-outline-purple:hover { background: var(--pss-primary); color: white; }
  .btn-outline-orange { border-color: var(--pd-primary); color: var(--pd-primary); }
  .btn-outline-orange:hover { background: var(--pd-primary); color: white; }
  .btn-outline-teal { border-color: var(--psse-primary); color: var(--psse-primary); }
  .btn-outline-teal:hover { background: var(--psse-primary); color: white; }

  /* ── SOFTWARE STRIP ── */
  .tools-strip {
    max-width: 1240px;
    margin: 64px auto 0;
    padding: 34px 24px;
    border-top: 1px solid var(--line-light);
    border-bottom: 1px solid var(--line-light);
    display: flex;
    align-items: center;
    gap: 28px;
    flex-wrap: wrap;
  }
  .tools-strip-label {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--text-mute);
    white-space: nowrap;
  }
  .tools-list { display: flex; gap: 28px; flex-wrap: wrap; }
  .tools-list span {
    font-family: 'IBM Plex Sans', sans-serif;
    font-weight: 600;
    color: var(--ink);
    font-size: 0.98rem;
    opacity: 0.75;
  }

  /* ── NOTIFY BANNER ── */
  .notify-banner {
    background: var(--ink);
    position: relative;
    overflow: hidden;
    margin-top: 96px;
  }
  .notify-banner::before {
    content: "";
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--copper), var(--emerald));
  }
  .notify-inner {
    max-width: 1240px;
    margin: 0 auto;
    padding: 64px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    flex-wrap: wrap;
  }
  .notify-text { max-width: 560px; }
  .notify-eyebrow {
    color: var(--copper);
    font-size: 0.85rem;
    font-weight: 700;
    margin-bottom: 12px;
    display: flex; align-items: center; gap: 8px;
  }
  .notify-text h2 {
    color: white;
    font-size: clamp(1.4rem, 2.6vw, 1.85rem);
    font-weight: 700;
    margin-bottom: 12px;
    letter-spacing: -0.3px;
  }
  .notify-text p {
    color: rgba(255,255,255,0.68);
    font-size: 0.98rem;
    line-height: 1.6;
  }
  .btn-notify-lg {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--copper);
    color: var(--ink);
    padding: 16px 30px;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.98rem;
    white-space: nowrap;
    transition: background 0.2s ease, transform 0.2s ease;
    flex-shrink: 0;
  }
  .btn-notify-lg:hover { background: #d69c53; transform: translateY(-1px); }

  /* ── WHY GRID ACADEMY ── */
  .why-section { background: var(--ink); padding: 88px 24px; }
  .why-inner { max-width: 1240px; margin: 0 auto; }
  .why-head { max-width: 620px; margin-bottom: 52px; }
  .why-inner .section-label { color: var(--copper); }
  .why-inner .section-title { color: white; }
  .why-inner .section-sub { color: rgba(255,255,255,0.6); }

  .features-grid {
    display: grid;
