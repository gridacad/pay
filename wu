<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Pay via Western Union - Grid Academy</title>
<link rel="icon" type="image/svg+xml" href="Sm1.svg">
<link rel="icon" type="image/png" sizes="32x32" href="Sm1.png">
<link rel="apple-touch-icon" href="Sm1.png">
<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-Y4NWHLNQS1"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-Y4NWHLNQS1');
</script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<style>
:root{
  --wu:#FFDD00; --wu-deep:#F2C900; --ink:#1a1a1a; --green:#009268; --green-dark:#007a56;
  --bg:#f7f6f2; --card:#fff; --line:#e6e3d8; --muted:#6b7280; --tint:#FFF9D6;
}
*{box-sizing:border-box}
body{margin:0;font-family:Cairo,"Segoe UI",Tahoma,Arial,sans-serif;background:var(--bg);color:var(--ink);line-height:1.55}
a{color:inherit}
:focus-visible{outline:3px solid var(--ink);outline-offset:2px}

/* NAV */
.top-nav{position:sticky;top:0;z-index:200;background:rgba(26,26,26,.97);backdrop-filter:blur(10px);padding:12px 0;box-shadow:0 2px 12px rgba(0,0,0,.25)}
.nav-inner{max-width:860px;margin:0 auto;padding:0 20px;display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}
.nav-back{display:flex;align-items:center;gap:7px;color:rgba(255,255,255,.8);text-decoration:none;font-size:.92rem;font-weight:600}
.nav-back:hover{color:var(--wu)}
.nav-badge{background:var(--wu);color:var(--ink);padding:5px 14px;border-radius:20px;font-size:.82rem;font-weight:700}

.breadcrumb{max-width:800px;margin:0 auto;padding:16px 20px 0;font-size:.88rem;color:var(--muted)}
.breadcrumb a{color:var(--green);text-decoration:none;font-weight:600}
.breadcrumb a:hover{text-decoration:underline}
.breadcrumb span{margin:0 6px}

.page-body{padding:16px 20px 40px}
.container{max-width:800px;margin:0 auto}

/* HERO: the one memorable element */
.hero{background:var(--wu);border-radius:14px 14px 0 0;padding:28px 32px;display:flex;align-items:center;gap:24px;flex-wrap:wrap;border-bottom:6px solid var(--ink)}
.hero svg{width:150px;height:auto;flex-shrink:0}
.hero h1{margin:0;font-size:1.7rem;line-height:1.2}
.hero p{margin:6px 0 0;font-size:1rem;max-width:46ch}
.chips{display:flex;gap:8px;flex-wrap:wrap;margin-top:14px}
.chip{background:var(--ink);color:#fff;border-radius:20px;padding:4px 12px;font-size:.82rem;font-weight:600}
.chip i{color:var(--wu);margin-right:5px}

.sheet{background:var(--card);border-radius:0 0 14px 14px;padding:32px;box-shadow:0 4px 12px rgba(0,0,0,.08)}
h2{font-size:1.3rem;margin:0 0 6px}
.lead{color:var(--muted);margin:0 0 18px;font-size:.95rem}
.section{margin-bottom:34px}

/* FIELDS (same pattern as the bank page) */
.info-box{margin-bottom:12px;padding:14px 16px;border:1px solid var(--line);border-left:5px solid var(--wu-deep);border-radius:8px;background:var(--tint)}
.info-box strong{font-size:.95rem}
.info-box small{display:block;color:var(--muted);font-size:.82rem;margin-top:2px}
.number-box{display:flex;align-items:center;justify-content:space-between;gap:12px;background:#fff;border:1px solid #d1d5db;border-radius:6px;padding:10px 12px;margin-top:8px;font-size:1.05rem;font-weight:700}
.number-box span{overflow-wrap:anywhere}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.grid2 .info-box{margin-bottom:0}
.rtl{direction:rtl;text-align:right;font-size:1.25rem}

.copy-btn{background:var(--ink);color:#fff;border:none;border-radius:5px;padding:7px 12px;cursor:pointer;font:600 13px Cairo,Arial,sans-serif;white-space:nowrap;transition:background .2s}
.copy-btn:hover{background:#000}
.copy-btn.done{background:var(--green)}

.warn{display:flex;gap:12px;align-items:flex-start;background:#fff4f4;border:1px solid #f1b5b5;border-radius:8px;padding:14px 16px;margin-top:14px;font-size:.93rem}
.warn i{color:#c0392b;margin-top:4px}

/* STEPS: real sequence, so numbered */
.steps{list-style:none;margin:0;padding:0;counter-reset:s}
.steps li{counter-increment:s;position:relative;padding:0 0 18px 52px}
.steps li::before{content:counter(s);position:absolute;left:0;top:0;width:36px;height:36px;border-radius:50%;background:var(--wu);border:2px solid var(--ink);font-weight:700;display:grid;place-items:center}
.steps li::after{content:"";position:absolute;left:17px;top:38px;bottom:2px;width:2px;background:var(--line)}
.steps li:last-child::after{display:none}
.steps b{display:block}

/* CONFIRM FORM */
.confirm{background:var(--ink);color:#fff;border-radius:12px;padding:24px}
.confirm h2{color:var(--wu)}
.confirm .lead{color:#cfcfcf}
.f-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.f-grid .full{grid-column:1/-1}
label{display:block;font-size:.85rem;font-weight:600;margin-bottom:4px}
input,select{width:100%;padding:10px 12px;border-radius:6px;border:2px solid transparent;font:600 1rem Cairo,Arial,sans-serif;background:#fff;color:var(--ink)}
input:focus,select:focus{outline:none;border-color:var(--wu)}
input.bad{border-color:#ff6b6b}
.err{color:#ff9d9d;font-size:.82rem;min-height:1.1em;margin-top:3px}
.actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:16px}
.btn{display:inline-flex;align-items:center;gap:8px;padding:11px 18px;border-radius:6px;border:none;cursor:pointer;font:700 .95rem Cairo,Arial,sans-serif;text-decoration:none}
.btn-wu{background:var(--wu);color:var(--ink)}
.btn-wu:hover{background:var(--wu-deep)}
.btn-ghost{background:transparent;color:#fff;border:2px solid #666}
.btn-ghost:hover{border-color:#fff}

.note{font-size:.85rem;color:var(--muted);margin-top:10px}
footer{max-width:800px;margin:20px auto 0;text-align:center;font-size:.85rem;color:var(--muted)}
footer a{color:var(--green);font-weight:600;text-decoration:none}

@media(max-width:600px){
  .hero{padding:22px 20px}.sheet{padding:22px 18px}
  .grid2,.f-grid{grid-template-columns:1fr}
  .number-box{flex-wrap:wrap}
}
@media (prefers-reduced-motion:reduce){*{transition:none!important}}
</style>
</head>
<body>

<nav class="top-nav">
  <div class="nav-inner">
    <a href="https://gridacad.github.io/course/index.html" class="nav-back"><i class="fas fa-chevron-left"></i> Back to Grid Academy</a>
    <span class="nav-badge">Western Union Payment</span>
  </div>
</nav>

<div class="page-body">
  <div class="breadcrumb" style="padding-left:0;padding-right:0">
    <a href="https://gridacad.github.io/course/index.html">Home</a><span>›</span><span>Pay via Western Union</span>
  </div>

  <div class="container">

    <!-- HERO -->
    <header class="hero">
      <!-- Stylised wordmark. Replace with the official logo file: <img src="western-union.svg" alt="Western Union"> -->
      <svg viewBox="0 0 220 74" role="img" aria-label="Western Union">
        <rect width="220" height="74" rx="8" fill="#1a1a1a"/>
        <text x="110" y="33" text-anchor="middle" font-family="Arial Black,Arial,sans-serif" font-weight="900" font-size="25" fill="#FFDD00" letter-spacing="1">WESTERN</text>
        <text x="110" y="61" text-anchor="middle" font-family="Arial Black,Arial,sans-serif" font-weight="900" font-size="25" fill="#FFDD00" letter-spacing="3">UNION</text>
      </svg>
      <div>
        <h1>Pay by Western Union cash pick-up</h1>
        <p>Send your payment to the receiver below. No bank account needed. Copy each detail exactly as shown.</p>
        <div class="chips">
          <span class="chip"><i class="fas fa-money-bill-wave"></i>Cash pick-up</span>
          <span class="chip"><i class="fas fa-location-dot"></i>Giza, Egypt</span>
          <span class="chip"><i class="fas fa-id-card"></i>Passport or ID required</span>
        </div>
      </div>
    </header>

    <main class="sheet">

      <!-- RECEIVER -->
      <section class="section">
        <h2>Receiver details</h2>
        <p class="lead">Enter these in the Western Union form. Tap Copy next to each one.</p>

        <div class="info-box">
          <strong>Receiver full name (Arabic)</strong>
          <small>As written on the national ID</small>
          <div class="number-box">
            <span id="nameAr" class="rtl" dir="rtl">مينا نبيل ديب عطاالله</span>
            <button class="copy-btn" data-target="nameAr">Copy</button>
          </div>
        </div>

        <div class="info-box">
          <strong>Receiver full name (English)</strong>
          <small>As written on the passport. Use this if the form only accepts Latin letters</small>
          <div class="number-box">
            <span id="nameEn">MENA NABIL DEEB ATTALLA</span>
            <button class="copy-btn" data-target="nameEn">Copy</button>
          </div>
        </div>

        <div class="grid2">
          <div class="info-box">
            <strong>Country</strong>
            <div class="number-box"><span id="country">Egypt</span><button class="copy-btn" data-target="country">Copy</button></div>
            <small>مصر</small>
          </div>
          <div class="info-box">
            <strong>City</strong>
            <div class="number-box"><span id="city">Giza</span><button class="copy-btn" data-target="city">Copy</button></div>
            <small>الجيزة</small>
          </div>
        </div>

        <div class="info-box" style="margin-top:12px">
          <strong>Receiver phone number</strong>
          <small>Mobile, with country code</small>
          <div class="number-box"><span id="phone" dir="ltr">+201205947400</span><button class="copy-btn" data-target="phone">Copy</button></div>
        </div>

        <div class="info-box">
          <strong>Payout method</strong>
          <div class="number-box"><span id="payout">Cash pick-up at a Western Union agent</span><button class="copy-btn" data-target="payout">Copy</button></div>
        </div>

        <div class="warn">
          <i class="fas fa-triangle-exclamation"></i>
          <div><b>Use one name, exactly as shown.</b> The receiver collects cash with a passport or national ID. Use the English name to match the passport, or the Arabic name to match the ID. Do not shorten, reorder or mix the two.</div>
        </div>
      </section>

      <!-- STEPS -->
      <section class="section">
        <h2>How to send</h2>
        <p class="lead">Online at westernunion.com, in the Western Union app, or at any agent near you.</p>
        <ol class="steps">
          <li><b>Choose the destination</b>Select Egypt as the country and Cash pick-up as the payout method.</li>
          <li><b>Enter the receiver</b>Paste the name (English or Arabic, not both), country, city and phone number from above.</li>
          <li><b>Enter the amount</b>Send the exact amount for your course. Check the fee shown before you pay.</li>
          <li><b>Pay and keep your receipt</b>You get a 10-digit tracking number (MTCN). Keep the receipt until the payment is confirmed.</li>
          <li><b>Send us the MTCN</b>Use the form below so we can confirm and release your access.</li>
        </ol>
      </section>

      <!-- CONFIRM -->
      <section class="confirm" id="confirm">
        <h2>Confirm your payment</h2>
        <p class="lead">Fill this in after you pay. It builds a message you can send on WhatsApp or copy anywhere.</p>
        <div class="f-grid">
          <div><label for="sName">Your full name</label><input id="sName" autocomplete="name"><div class="err" id="eName"></div></div>
          <div><label for="sCountry">Country you sent from</label><input id="sCountry" autocomplete="country-name"><div class="err" id="eCountry"></div></div>
          <div><label for="sAmount">Amount sent</label><input id="sAmount" inputmode="decimal" placeholder="e.g. 150"><div class="err" id="eAmount"></div></div>
          <div><label for="sCur">Currency</label>
            <select id="sCur"><option>USD</option><option>EUR</option><option>GBP</option><option>SAR</option><option>AED</option><option>KWD</option><option>QAR</option><option>EGP</option><option>Other</option></select>
          </div>
          <div class="full"><label for="sMtcn">MTCN (10 digits)</label><input id="sMtcn" inputmode="numeric" maxlength="14" placeholder="1234567890"><div class="err" id="eMtcn"></div></div>
        </div>
        <div class="actions">
          <button class="btn btn-wu" id="wa"><i class="fab fa-whatsapp"></i> Send on WhatsApp</button>
          <button class="btn btn-ghost" id="cpy"><i class="far fa-copy"></i> Copy message</button>
        </div>
      </section>

      <p class="note"><i class="fas fa-lock"></i> Only send money to the name and number on this page. Never share your MTCN with anyone else.</p>
    </main>

    <footer>
      <a href="https://gridacad.github.io/course/index.html"><i class="fas fa-arrow-left"></i> Return to GRID ACADEMY | Power Systems Engineering Courses</a>
    </footer>
  </div>
</div>

<script>
const WA_NUMBER = "201205947400";

function copyText(text){
  if (navigator.clipboard && window.isSecureContext) return navigator.clipboard.writeText(text);
  return new Promise((res, rej) => {
    const t = document.createElement("textarea");
    t.value = text; t.style.position = "fixed"; t.style.opacity = "0";
    document.body.appendChild(t); t.select();
    try { document.execCommand("copy") ? res() : rej(); } catch(e){ rej(e); }
    t.remove();
  });
}
function flash(btn, ok, label){
  const orig = label || "Copy";
  btn.textContent = ok ? "Copied!" : "Press Ctrl+C";
  btn.classList.toggle("done", ok);
  setTimeout(() => { btn.innerHTML = orig; btn.classList.remove("done"); }, 1800);
}

document.querySelectorAll(".copy-btn").forEach(btn => {
  btn.addEventListener("click", () => {
    const text = document.getElementById(btn.dataset.target).textContent.trim();
    copyText(text).then(() => flash(btn, true), () => flash(btn, false));
  });
});

/* Confirmation message */
const $ = id => document.getElementById(id);
function build(){
  let ok = true;
  const set = (input, err, msg) => { $(err).textContent = msg; $(input).classList.toggle("bad", !!msg); if (msg) ok = false; };
  const mtcn = $("sMtcn").value.replace(/\D/g, "");
  set("sName", "eName", $("sName").value.trim() ? "" : "Enter your name.");
  set("sCountry", "eCountry", $("sCountry").value.trim() ? "" : "Enter the country.");
  set("sAmount", "eAmount", parseFloat($("sAmount").value) > 0 ? "" : "Enter the amount you sent.");
  set("sMtcn", "eMtcn", mtcn.length === 10 ? "" : "The MTCN has exactly 10 digits.");
  if (!ok) return null;
  return "Western Union payment sent\n" +
    "Name: " + $("sName").value.trim() + "\n" +
    "Sent from: " + $("sCountry").value.trim() + "\n" +
    "Amount: " + $("sAmount").value.trim() + " " + $("sCur").value + "\n" +
    "MTCN: " + mtcn + "\n" +
    "Receiver: MENA NABIL DEEB ATTALLA / مينا نبيل ديب عطاالله, Giza, Egypt";
}
$("wa").addEventListener("click", () => {
  const m = build(); if (!m) return;
  window.open("https://wa.me/" + WA_NUMBER + "?text=" + encodeURIComponent(m), "_blank", "noopener");
});
$("cpy").addEventListener("click", () => {
  const m = build(); if (!m) return;
  const b = $("cpy");
  copyText(m).then(() => flash(b, true, '<i class="far fa-copy"></i> Copy message'),
                   () => flash(b, false, '<i class="far fa-copy"></i> Copy message'));
});
</script>
</body>
</html>
